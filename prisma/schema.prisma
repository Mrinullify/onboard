// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

//---------------------------------------------------------------------------------------
// enums
enum Difficulty {
    EASY
    MEDIUM
    HARD
}

enum AssessmentStatus {
    GENERATING
    ACTIVE
    SUBMITTED
    COMPLETED
    TERMINATED
}

enum QuestionType {
    MCQ
    CODING
    SCENARIO
}

enum TestStatus {
    IN_PROGRESS
    COMPLETED
}

enum AssessmentResult {
    EXCELLENT
    GOOD
    AVERAGE
    NEEDS_IMPROVEMENT
}

//AUTH TABLES
//----------------------------------------------------------------------------

// Adapter Models
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

//--------------------------------------------------------------------

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    password      String?
    image         String?

    accounts Account[]
    // sessions Session[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tests Test[]

    assessmentAttempts AssessmentAttempt[]

    resumes        Resume[]
    resumeAnalyses ResumeAnalysis[]
    vectorChunks   VectorChunk[]
}

//-------------------------------------------------------------------------------

model Test {
    id String @id @default(cuid())

    title      String
    role       String
    status     TestStatus
    difficulty Difficulty

    createdAt DateTime @default(now())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    assessmentAttempts AssessmentAttempt[]
}

//----------------------------------------------------------------------------------
model AssessmentAttempt {
    id String @id @default(cuid())

    status AssessmentStatus @default(GENERATING)

    startedAt DateTime  @default(now())
    endedAt   DateTime?

    durationMinutes Int

    fullscreenStrikes Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    testId String
    test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

    // Overall assessment stats
    totalQuestions Int    @default(0)
    totalMarks     Int    @default(0)
    obtainedMarks  Float?
    percentage     Float?

    questions AssessmentQuestion[]
    answers   AssessmentAnswer[]

    result AssessmentResult?

    @@index([userId])
    @@index([testId])
}

//---------------------------------------------------------------------------------------

model AssessmentQuestion {
    id String @id @default(cuid())

    //------------------------------------
    // Relations
    //------------------------------------

    assessmentAttemptId String
    assessmentAttempt   AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)

    answers AssessmentAnswer?

    //------------------------------------
    // Basic Question Information
    //------------------------------------

    questionType QuestionType
    difficulty   Difficulty

    topic        String
    questionText String

    //------------------------------------
    // Timing & Marks
    //------------------------------------

    timeLimit Int
    marks     Int

    //------------------------------------
    // Question Specific Data
    //------------------------------------

    metadata Json

    //------------------------------------
    // Audit
    //------------------------------------

    createdAt DateTime @default(now())
}

//---------------------------------------------------------------------------------------

model AssessmentAnswer {
    id String @id @default(cuid())

    assessmentAttemptId  String
    assessmentQuestionId String @unique

    assessmentAttempt AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)

    assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

    userAnswer String?

    timeTaken  Int?
    answeredAt DateTime?

    score        Float?
    feedback     String?
    aiEvaluation Json?

    // Optional - prevents multiple submissions for the same question
    @@unique([assessmentAttemptId, assessmentQuestionId])
    @@index([assessmentAttemptId])
    @@index([assessmentQuestionId])
}

//---------------------------------------------------------------------------------------
// RESUME & CAREER AGENT MODELS
//---------------------------------------------------------------------------------------

model Resume {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    version       Int     @default(1)
    fileName      String
    filePath      String? // Relative path to local file storage or remote URL
    extractedText String  @db.Text
    targetRole    String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    analyses     ResumeAnalysis[]
    vectorChunks VectorChunk[]

    @@index([userId])
    @@index([userId, version])
}

model ResumeAnalysis {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    resumeId String
    resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

    score           Float?
    atsScore        Float?
    grammarScore    Float?
    strengths       Json // string[]
    weaknesses      Json // string[]
    missingSkills   Json // string[]
    recommendations Json // string[]
    feedback        String? @db.Text

    createdAt DateTime @default(now())

    @@index([userId])
    @@index([resumeId])
}

model VectorChunk {
    id String @id @default(cuid())

    userId String? // null for market knowledge chunks
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    sourceType      String // "resume" | "resume_feedback" | "market"
    resumeId        String?
    resume          Resume? @relation(fields: [resumeId], references: [id], onDelete: Cascade)
    resumeVersion   Int?
    section         String? // e.g., "skills", "experience", "education", "feedback"
    targetRole      String?
    source          String? // "user_upload", "market_seed", "web_scrape"
    sourceReference String? // URL, title or identifier

    text String @db.Text // authoritative chunk text

    createdAt DateTime @default(now())

    @@index([userId])
    @@index([sourceType])
    @@index([resumeId])
}
